# Runtime PostgreSQL connection. Use a transaction pooler for serverless deployments.
DATABASE_URL=postgresql://postgres:password@localhost:5432/founder_circle
# Prisma migrations use a direct or session-mode connection, never a transaction pooler.
# Render-managed Postgres: use the same connection string as DATABASE_URL.
# Supabase Postgres: configure its separate direct/session-mode URL here.
DIRECT_URL=postgresql://postgres:password@localhost:5432/founder_circle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required production canonical origin (no trailing slash)
APP_URL=http://localhost:3000
# Never enable outside local development. Production explicitly ignores this flag.
LOCAL_DEMO=false
# Optional API origin override. Vercel production defaults to the deployed Render backend.
# Leave unset on Render to keep requests in the backend rather than proxying to itself.
BACKEND_URL=

# Roles are stored in the database. See MODERATION.md for the trusted bootstrap command.

# Recommendations work without any external provider. Backend only; see RECOMMENDATIONS.md.
RECOMMENDATIONS_ENABLED=true
# scripts/start.mjs enables the worker on Render. Keep false on frontend-only processes.
RECOMMENDATION_WORKER_ENABLED=false
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=
EMBEDDING_MODEL=
# Optional structured extraction model; empty uses local extraction.
AI_TEXT_MODEL=
