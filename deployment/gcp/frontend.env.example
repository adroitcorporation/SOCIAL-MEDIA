# Vercel NEW staging project. No SQL credentials or service account keys.
NEXT_PUBLIC_AUTH_PROVIDER=identity-platform
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_STAGING_PROJECT
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_STAGING_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=PUBLIC_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_APP_ID=PUBLIC_WEB_APP_ID
NEXT_PUBLIC_APP_URL=https://YOUR_STAGING_FRONTEND.vercel.app
APP_URL=https://YOUR_STAGING_FRONTEND.vercel.app
BACKEND_URL=https://YOUR_STAGING_BACKEND.asia-south1.run.app
REQUIRE_EXPLICIT_BACKEND_URL=true
LOCAL_DEMO=false
RECOMMENDATION_WORKER_ENABLED=false
