# Values for a NEW staging GCP project only. No credentials belong here.
DEPLOYMENT_TARGET=cloud-run
GCP_PROJECT_ID=YOUR_STAGING_PROJECT
FIREBASE_AUTH_PROJECT_ID=cynk-staging-e9c53
APP_ENV=staging
CLOUD_SQL_CONNECTION_NAME=YOUR_STAGING_PROJECT:asia-south2:cynk-staging-db
AUTH_PROVIDER=identity-platform
NEXT_PUBLIC_AUTH_PROVIDER=identity-platform
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cynk-staging-e9c53
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cynk-staging-e9c53.firebaseapp.com
NEXT_PUBLIC_FIREBASE_API_KEY=PUBLIC_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_APP_ID=PUBLIC_WEB_APP_ID
NEXT_PUBLIC_FIREBASE_OAUTH_PROVIDERS=google,github
APP_URL=https://SET_CONFIRMED_STAGING_SERVICE.run.app
NEXT_PUBLIC_APP_URL=https://SET_CONFIRMED_STAGING_SERVICE.run.app
FILE_STORAGE_MODE=gcs
LOCAL_DEMO=false
RECOMMENDATION_WORKER_ENABLED=false
MIGRATION_MAINTENANCE=true
# Set DATABASE_URL through Secret Manager, NOT this file:
# postgresql://cynk_runtime:URL_ENCODED_PASSWORD@localhost/cynk_staging?host=/cloudsql/PROJECT:asia-south2:cynk-staging-db&connection_limit=2&pool_timeout=10
# Only the migration job receives DIRECT_URL, using cynk_migrator and the same socket/database.
